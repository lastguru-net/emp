{% set data = social or siteelements.social %}
{% set iconAliases = {fbPage: "facebookInverse", fbProfile: "facebook"} %}
<div class="{% if social %}authorsocial{% else %}sitesocial{% endif %} grid grid-cols-{{ data | length }}">
    {% for name in ["linkedin", "github", "twitter_x", "youtube", "fbPage", "fbProfile", "instagram", "threads", "mastodon", "bluesky"] %}
    {% if data[name] %}
    {% set config = socialconfig[name] %}
    {% set icon = inlinesvg[iconAliases[name] or name] %}
    {% set fullUrl = name == "mastodon" or name == "bluesky" %}
    <a href="{{ '' if fullUrl else config.prefix }}{{ data[name] }}" aria-label="{{ config.aria }}"{% if fullUrl %} rel="me"{% endif %}>
        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="{{ icon.viewBox }}">
            <title>{{ config.title }}</title>
            <path d="{{ icon.path }}" />
        </svg>
    </a>
    {% endif %}
    {% endfor %}
</div>
