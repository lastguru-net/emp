{% import "post-properties-data.njk" as prepared with context %}
{% set data = post.data %}
{% set image = data.thumbnail or data.image %}
{% set thumbnail = (image | postThumbnail(siteelements.features.lqip)) if siteelements.features.postlistThumbnail and data.thumbnail != false and image else null %}
{% set card = {
    id: (data.id or post.filePathStem or post.fileSlug or post.url or "") | string,
    url: post.url | url,
    title: data.title | default(""),
    excerpt: data.excerpt or (post | getExcerpt),
    pinned: data.pinned == true,
    thumbnail: thumbnail,
    properties: prepared.properties
} %}
