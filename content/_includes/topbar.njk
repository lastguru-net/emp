<header {% if siteelements.features.topbar == "dynamic" %}id="top-bar"{% endif %} class="top-bar">
    <div class="max-w-content">
        <div id="mobile-top-bar">
            <button id="sidebar-open" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="{{ sitestrings[siteconfig.lang].open_sidebar_menu }}" onclick="slideLeftSidebar()">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 80">
                    <rect width="60" height="7" />
                    <rect y="30" width="60" height="7" />
                    <rect y="60" width="60" height="7" />
                </svg>
            </button>
            <a href="{{ '/' | url }}" aria-label="{{ siteelements.menuHome }}">{{ siteconfig.title }}</a>
            {% if siteelements.features.colorMode != "light" and siteelements.features.colorMode != "dark" %}
            <button type="button" aria-label="{{ sitestrings[siteconfig.lang].color_mode }}" onclick="toggleDarkLightMode(false)">
                <svg class="lighttoggle" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="{{ inlinesvg.lightMode.viewBox }}">
                    <path d="{{ inlinesvg.lightMode.path }}" />
                </svg>
                <svg class="darktoggle" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="{{ inlinesvg.darkMode.viewBox }}">
                    <path d="{{ inlinesvg.darkMode.path }}" />
                </svg>
            </button>
            {% endif %}
        </div>
    </div>
</header>