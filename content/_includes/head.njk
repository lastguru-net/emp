<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% if siteelements.features.colorMode == "light" %}{% set colorScheme = "light" %}
{% elseif siteelements.features.colorMode == "dark" %}{% set colorScheme = "dark" %}
{% elseif siteelements.features.colorMode == "light-dark" %}{% set colorScheme = "light dark" %}
{% elseif siteelements.features.colorMode == "dark-light" %}{% set colorScheme = "dark light" %}
{% else %}{% set colorScheme = "dark light" %}{% endif %}
<meta name="color-scheme" content="{{ colorScheme }}">
<title>{% if title %}{{ title }} - {% endif %}{{ siteconfig.title }}</title>
{% set description -%}{% getShortDescription %}{%- endset %}
{% set activeAuthorId = author or siteconfig.author %}
{% set activeAuthorData = siteauthors[activeAuthorId] %}
{% set activeAuthorDisplayName = activeAuthorData.fullName if activeAuthorData else activeAuthorId %}
<meta name="author" content="{{ activeAuthorDisplayName }}">
<meta name="description" content="{{ description }}">
{% if siteelements.features.generator %}<meta name="generator" content="Eleventy">{% endif %}
{% set imageSrc = image or siteconfig.openGraphDefaultImage %}
{% set isPost = tags and ('posts' in tags) %}
{% set isAuthorPage = tags and ('authorcard' in tags) %}
{% include "opengraph.njk" %}
{% include "twittercard.njk" %}
{% for name, item in meta %}
<meta name="{{ name }}" content="{{ item.value }}">
{% endfor %}
{% for iconsize in siteconfig.appleiconSizes %}
<link rel="apple-touch-icon" sizes="{{ iconsize }}x{{ iconsize }}" href="{% imageTransform siteconfig.favicon, iconsize, 'png' %}">
{% endfor %}
{% for iconsize in siteconfig.faviconSizes %}
<link rel="icon" type="image/png" sizes="{{ iconsize }}x{{ iconsize }}" href="{% imageTransform siteconfig.favicon, iconsize, 'png' %}">
{% endfor %}
{% if siteconfig.webmanifestSizes %}<link rel="manifest" href="{{ '/site.webmanifest' | url }}" crossorigin="use-credentials">{% endif %}
<link rel="canonical" href="{{ page.url | absoluteUrl }}">
{% if siteelements.features.sitemap %}<link rel="sitemap" type="application/xml" title="Sitemap" href="{{ '/sitemap.xml' | url }}">{% endif %}
{% if siteelements.feeds.rss %}<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="{{ '/rss.xml' | absoluteUrl }}">{% endif %}
{% if siteelements.feeds.atom %}<link rel="alternate" type="application/atom+xml" title="Atom Feed" href="{{ '/atom.xml' | absoluteUrl }}">{% endif %}
{% if siteelements.feeds.json %}<link rel="alternate" type="application/feed+json" title="JSON Feed" href="{{ '/feed.json' | absoluteUrl }}">{% endif %}
<link rel="preload" href="{{ '/assets/css/min.css' | addDirHash | url }}" as="style">
<link rel="stylesheet" href="{{ '/assets/css/min.css' | addDirHash | url }}">
{% if siteelements.features.colorMode != "light" and siteelements.features.colorMode != "dark" %}
{% include "colormode-js.njk" %}
{% endif %}
{% if siteelements.features.js %}<script defer src="{{ '/assets/js/min.js' | addDirHash | url }}" type="module"></script>{% endif %}
{% pluginsHead %}