<footer class="footer">
    <div class="footer-content max-w-content">
        <div class="footer-identity">
            {% if siteelements.feeds.rssInFooter %}
            <a class="footer-rss" href="{{ '/rss.xml' | url }}" aria-label="RSS Feed">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="{{ inlinesvg.rss.viewBox }}">
                    <title>RSS</title>
                    <path d="{{ inlinesvg.rss.path }}" />
                </svg>
            </a>
            {% endif %}
            {% set copyright = siteelements.copyright %}
            {% set publisherData = siteauthors[siteconfig.author] %}
            {% set publisherName = publisherData.fullName if publisherData else siteconfig.author %}
            <div class="footer-copyright">
                <span class="footer-copyright-text">
                    &copy; {% if copyright.year %}{{ copyright.year }}{% else %}{% year %}{% endif %}
                </span>
                {% if copyright.link %}
                <a class="footer-copyright-author" href="{{ copyright.link | url }}">
                    {{ publisherName }}
                </a>
                {% else %}
                <span class="footer-copyright-author">
                    {{ publisherName }}
                </span>
                {% endif %}
                <span class="footer-copyright-text">
                    {{ copyright.text }}
                </span>
            </div>
        </div>
        {% if siteelements.features.privacyPolicy == "footer" %}
        <a class="footer-privacy-policy" href="{{ siteelements.privacyPolicy.url | url }}" aria-label="{{ siteelements.privacyPolicy.name }}">
            {{ siteelements.privacyPolicy.name }}
        </a>
        {% endif %}
        {% if siteelements.features.sitesocial == "footer" and (siteelements.social | length) %}
        {% include "sitesocial.njk" %}
        {% endif %}
        {% if siteelements.features.poweredBy %}
        <span class="footer-poweredby">
            <span class="footer-poweredby-prefix">
                {{ siteelements.poweredBy.text }}
            </span>
            {% if siteelements.poweredBy.url %}
            <a class="footer-poweredby-link" href="{{ siteelements.poweredBy.url | url }}" aria-label="{{ siteelements.poweredBy.name }}">
                {{ siteelements.poweredBy.name }}
            </a>
            {% else %}
            <span class="footer-poweredby-text">
                {{ siteelements.poweredBy.name }}
            </span>
            {% endif %}
        </span>
        {% endif %}
    </div>
</footer>