{% set items = [] %}
{% for post in posts %}
    {% import "post-card-data.njk" as prepared with context %}
    {% set _ = items.push(prepared.card) %}
{% endfor %}
{% set list = items | postlistData(pagination) %}
<div class="postlist">
    {% if siteelements.header and siteheader %}
        {% if siteelements.headerLink %}
        <a class="siteheaderlink" href="{{ siteelements.headerLink | url }}">
            <img class="siteheader" src="{{ siteelements.header }}" alt="{{ siteelements.headerAlt }}" fetchpriority="high" />
        </a>
        {% else %}
        <img class="siteheader" src="{{ siteelements.header }}" alt="{{ siteelements.headerAlt }}" fetchpriority="high" />
        {% endif %}
    {% endif %}
    {% if title and not authorCard %}<h1>{{ title }}</h1>{% endif %}
    {% include postlistTemplate %}
</div>
