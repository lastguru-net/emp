---
layout: base.njk
---

<div class="content post">
    <h1>{{ title }}</h1>
    {% if siteelements.features.postproperties %}
        {% set post = collections.posts | getCollectionItem(page) %}
        {% if siteelements.features.postproperties == "above" %}
        {% include "postproperties.njk" %}
        {% endif %}
    {% endif %}
    {% if image %}
    <img class="postimage" src="{{ image }}" alt="{{ imageAlt }}" fetchpriority="high" />
    {% endif %}
    {% if siteelements.features.postproperties and siteelements.features.postproperties != "above" %}
        {% include "postproperties.njk" %}
    {% endif %}
    {% if siteelements.features.sharer == "above" or siteelements.features.sharer == "both" %}
        {% set sharerPosition = "above" %}
        {% include "social.njk" %}
    {% endif %}
    <div class="incontent{% if siteelements.features.initialLetter %} initial-letter{% endif %}">
        {{ content | safe }}
    </div>
    {% if siteelements.features.sharer == true or siteelements.features.sharer == "below" or siteelements.features.sharer == "both" %}
        {% set sharerPosition = "below" %}
        {% include "social.njk" %}
    {% endif %}
    {% if siteelements.features.prevnext or postAttachments | length or postUpdates | length %}
    <div class="postbreak"></div>
    {% endif %}
    {% if postAttachments | length or postUpdates | length %}
    <div class="incontent">{% include "post-additions.njk" %}</div>
    {% endif %}
    {% if siteelements.features.prevnext %}
    <div class="additions">
        {% set previousPost = collections.empPosts | getPreviousCollectionItem(page) %}
        {% set nextPost = collections.empPosts | getNextCollectionItem(page) %}
        <a {% if previousPost.url %}href="{{ previousPost.url | url }}"{% endif %} aria-label="{% if previousPost.url %}{{ sitestrings[siteconfig.lang].older }}: {{ previousPost.data.title }}{% endif %}">
            <div class="prevnextprev {% if previousPost.url %}prevnextyes{% else %}prevnextno{% endif %}">
                {# chevron left + title, vertically centered #}
                <svg class="chevron-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="{{ inlinesvg.chevronLeft.viewBox }}">
                    <path d="{{ inlinesvg.chevronLeft.path }}" />
                </svg>
                <span class="prevnextlink">{% if not previousPost.url %} - {% else %}{{ previousPost.data.title | truncate(60, false, "…") }}{% endif %}</span>
            </div>
        </a>
        <a {% if nextPost.url %}href="{{ nextPost.url | url }}"{% endif %} aria-label="{% if nextPost.url %}{{ sitestrings[siteconfig.lang].newer }}: {{ nextPost.data.title }}{% endif %}">
            <div class="prevnextnext {% if nextPost.url %}prevnextyes{% else %}prevnextno{% endif %}">
                {# title + chevron right, vertically centered and aligned to the right #}
                <span class="prevnextlink">{% if not nextPost.url %} - {% else %}{{ nextPost.data.title | truncate(60, false, "…") }}{% endif %}</span>
                <svg class="chevron-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="{{ inlinesvg.chevronRight.viewBox }}">
                    <path d="{{ inlinesvg.chevronRight.path }}" />
                </svg>
            </div>
        </a>
    </div>
    {% endif %}
</div>