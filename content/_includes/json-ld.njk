{% if siteelements.features.json_ld %}
{# Page description #}
{% set description -%}{% getShortDescription %}{%- endset %}
{# Page type detection #}
{% set isPost = tags and ('posts' in tags) %}
{% set isAuthorPage = tags and ('authorcard' in tags) %}
{% set pageUrl = page.url | absoluteUrl %}
{% set pageTitle = (title ~ " - " if title else "") ~ siteconfig.title %}
{% set imageSrc = image or siteconfig.openGraphDefaultImage %}
{% set isProfilePage = (not isPost and not isAuthorPage and profilePage) %}

{# Detect events: any tag included in sitetags.events #}
{% set isEvent = false %}
{% if tags %}
    {% for evtag in sitetags.events %}
        {% if evtag in tags %}{% set isEvent = true %}{% endif %}
    {% endfor %}
{% endif %}

{# Unified author derivation (for both posts and author pages) #}
{% set activeAuthorId = author or siteconfig.author %}
{% set activeAuthorData = siteauthors[activeAuthorId] %}
{% set activeAuthorDisplayName = activeAuthorData.fullName or activeAuthorId %}
{% set authorImage = activeAuthorData.photo or siteconfig.image %}
{% set authorPageUrl = (siteconfig.pagination.authorLinkPrefix ~ (activeAuthorId | empSlugify) ~ '/') | absoluteUrl %}

{# Generate keywords from tags #}
{% if isPost %}
    {% set keywords = tags | getKeywords %}
{% endif %}

{# Author sameAs links #}
{% set sameAs = [activeAuthorData.website] if activeAuthorData.website else [] %}
{% set social = activeAuthorData.social or {} %}
{% for key, value in social %}
    {% set cfg = socialconfig[key] %}
    {% set sameAs = sameAs.concat([cfg.prefix ~ value]) %}
{% endfor %}

{# Publisher sameAs links #}
{% set publisherSameAs = [] %}
{% for key, value in siteelements.social %}
    {% set cfg = socialconfig[key] %}
    {% set publisherSameAs = publisherSameAs.concat([cfg.prefix ~ value]) %}
{% endfor %}

{# Publisher context #}
{% set publisherData = siteauthors[siteconfig.author] %}
{% set publisherName = publisherData.fullName or siteconfig.author %}
{% set publisherImage = publisherData.photo or siteconfig.image %}

{% set publisherFields %}
    "@type": {{ siteconfig.authorType | jsonScript | safe }},
    "name": {{ publisherName | jsonScript | safe }},
    "url": {{ '/' | absoluteUrl | jsonScript | safe }},
    {% if publisherData.bio %}"description": {{ publisherData.bio | jsonScript | safe }},{% endif %}
    {% if publisherData.email %}"email": {{ publisherData.email | jsonScript | safe }},{% endif %}
    {% if publisherSameAs | length %}"sameAs": {{ publisherSameAs | jsonScript | safe }},{% endif %}
    {{ ('image' if siteconfig.authorType == 'Person' else 'logo') | jsonScript | safe }}: {
        "@type": "ImageObject",
        "url": {% set transformedImage %}{% imageTransformAbsoluteUrl publisherImage, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }}
    }
{% endset %}

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": {{ ('/' | absoluteUrl ~ "#website") | jsonScript | safe }},
            "name": {{ siteconfig.title | jsonScript | safe }},
            "url": {{ '/' | absoluteUrl | jsonScript | safe }},
            "inLanguage": {{ siteconfig.lang | jsonScript | safe }},
            "description": {{ siteconfig.description | jsonScript | safe }},
            "logo": {
                "@type": "ImageObject",
                "url": {% set transformedImage %}{% imageTransformAbsoluteUrl siteconfig.image, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }}
            },
            "publisher": {
                {{ publisherFields | safe }}
            }
        }
        {% if isEvent %}
        ,{
            "@type": "Event",
            "@id": {{ (pageUrl ~ "#event") | jsonScript | safe }},
            "name": {{ title | jsonScript | safe }},
            "url": {{ pageUrl | jsonScript | safe }},
            "isPartOf": { "@id": {{ ('/' | absoluteUrl ~ "#website") | jsonScript | safe }} },
            "inLanguage": {{ siteconfig.lang | jsonScript | safe }},
            "description": {{ description | jsonScript | safe }},
            "image": [
                {% set transformedImage %}{% imageTransformAbsoluteUrl imageSrc, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }}
            ],
            "startDate": {{ page.date | isoDateTime | jsonScript | safe }},
            {% if place %}"location": {
                "@type": "Place",
                "name": {{ place | jsonScript | safe }}{% if address %},
                "address": {{ address | jsonScript | safe }}{% endif %}
            },{% endif %}
            "organizer": {
                {{ publisherFields | safe }}
            }
        }
        {% elseif isPost %}
        ,{
            "@type": "BlogPosting",
            "@id": {{ (pageUrl ~ "#blogposting") | jsonScript | safe }},
            "headline": {{ pageTitle | jsonScript | safe }},
            "url": {{ pageUrl | jsonScript | safe }},
            "isPartOf": { "@id": {{ ('/' | absoluteUrl ~ "#website") | jsonScript | safe }} },
            "mainEntityOfPage": {{ pageUrl | jsonScript | safe }},
            "inLanguage": {{ siteconfig.lang | jsonScript | safe }},
            "description": {{ description | jsonScript | safe }},
            "image": [
                {% set transformedImage %}{% imageTransformAbsoluteUrl imageSrc, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }}
            ],
            "datePublished": {{ page.date | isoDateTime | jsonScript | safe }},
            {% if updated %}"dateModified": {{ updated | isoDateTime | jsonScript | safe }},{% endif %}
            "keywords": {{ keywords | jsonScript | safe }},
            "author": {
                "@type": "Person",
                "name": {{ activeAuthorDisplayName | jsonScript | safe }},
                "url": {{ authorPageUrl | jsonScript | safe }},
                {% if activeAuthorData.bio %}"description": {{ activeAuthorData.bio | jsonScript | safe }},{% endif %}
                {% if activeAuthorData.email %}"email": {{ activeAuthorData.email | jsonScript | safe }},{% endif %}
                {% if sameAs | length %}"sameAs": {{ sameAs | jsonScript | safe }},{% endif %}
                "image": {
                    "@type": "ImageObject",
                    "url": {% set transformedImage %}{% imageTransformAbsoluteUrl authorImage, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }}
                }
            },
            "publisher": {
                {{ publisherFields | safe }}
            }
        }
        {% elseif isAuthorPage %}
        ,{
            "@type": "ProfilePage",
            "@id": {{ (pageUrl ~ "#profilepage") | jsonScript | safe }},
            "name": {{ pageTitle | jsonScript | safe }},
            "url": {{ pageUrl | jsonScript | safe }},
            "isPartOf": { "@id": {{ ('/' | absoluteUrl ~ "#website") | jsonScript | safe }} },
            "mainEntity": { "@id": {{ (pageUrl ~ "#author") | jsonScript | safe }} },
            "inLanguage": {{ siteconfig.lang | jsonScript | safe }},
            "description": {{ description | jsonScript | safe }}
        },
        {
            "@type": "Person",
            "@id": {{ (pageUrl ~ "#author") | jsonScript | safe }},
            "name": {{ activeAuthorDisplayName | jsonScript | safe }},
            "url": {{ pageUrl | jsonScript | safe }},
            {% if activeAuthorData.bio %}"description": {{ activeAuthorData.bio | jsonScript | safe }},{% endif %}
            {% if activeAuthorData.email %}"email": {{ activeAuthorData.email | jsonScript | safe }},{% endif %}
            {% if sameAs | length %}"sameAs": {{ sameAs | jsonScript | safe }},{% endif %}
            "image": {
                "@type": "ImageObject",
                "url": {% set transformedImage %}{% imageTransformAbsoluteUrl authorImage, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }}
            }
        }
        {% elseif isProfilePage %}
        ,{
            "@type": "ProfilePage",
            "@id": {{ (pageUrl ~ "#profilepage") | jsonScript | safe }},
            "name": {{ pageTitle | jsonScript | safe }},
            "url": {{ pageUrl | jsonScript | safe }},
            "isPartOf": { "@id": {{ ('/' | absoluteUrl ~ "#website") | jsonScript | safe }} },
            "mainEntity": { "@id": {{ (pageUrl ~ "#profile") | jsonScript | safe }} },
            "inLanguage": {{ siteconfig.lang | jsonScript | safe }},
            "description": {{ description | jsonScript | safe }}
        },
        {
            "@id": {{ (pageUrl ~ "#profile") | jsonScript | safe }},
            {{ publisherFields | safe }}
        }
        {% else %}
        ,{
            "@type": "WebPage",
            "@id": {{ (pageUrl ~ "#webpage") | jsonScript | safe }},
            "name": {{ pageTitle | jsonScript | safe }},
            "url": {{ pageUrl | jsonScript | safe }},
            "isPartOf": { "@id": {{ ('/' | absoluteUrl ~ "#website") | jsonScript | safe }} },
            "inLanguage": {{ siteconfig.lang | jsonScript | safe }},
            "description": {{ description | jsonScript | safe }}
        }
        {% endif %}
    ]
}
</script>
{% endif %}