{
    // Feature toggles and layout options
    features: {
        // Post properties: false disables; 'above'/'below' the full-post image; true means 'below'
        postproperties: "below",
        // Load metrics/actions JSON on full posts; requires js and postproperties
        liveMetricsActions: false,
        // Include description in OpenGraph and Twitter meta tags
        og_description: true,
        // Generate and include JSON-LD structured data
        json_ld: true,
        // Include the sitemap link in the HTML head
        sitemap: true,
        // Include local JavaScript bundle
        js: true,
        // Show the sidebar user menu (requires js: true)
        userMenu: false,
        // Sharing on posts/pages: 'both' (default), 'above' or 'below' the body; false disables; true means 'below'
        sharer: "both",
        // Enable previous/next post navigation
        prevnext: true,
        // Color mode: 'light' or 'dark' (fixed), 'light-dark' or 'dark-light' (initial theme with a toggle),
        // or 'auto' (initial system preference); toggle modes remember the selection in local storage
        // Theme selection uses inline JavaScript independently of features.js
        colorMode: "auto",
        // Base layout: 'regular' (with sidebar) or 'primitive' (minimal layout)
        base: "regular",
        // Homepage layout: 'postlist' (uses siteconfig.pagination.postlist) or 'singlepost' (full post)
        index: "postlist",
        // Top bar behavior: false (none), 'static' (always visible), or 'dynamic' (shows/hides on scroll)
        topbar: "dynamic",
        // Display the site image before the top bar title
        topbarLogo: false,
        // Location of the Privacy Policy link: 'footer', 'sidebar', or false (none)
        privacyPolicy: "sidebar",
        // Display footer information (e.g., copyright, author)
        footer: true,
        // Location of the site social block: false, 'above' or 'below' the sidebar menu, or 'footer'
        sitesocial: "below",
        // Postlist thumbnail: false | 'left' | 'right'
        postlistThumbnail: "right",
        // Show author business card on author listing pages
        authorCard: true,
        // Toggle for showing "Powered by" text/link in the footer
        poweredBy: true,
        // Include generator meta tag
        generator: true,
        // Toggle Lean Rada CSS-only LQIP placeholders
        lqip: true,
        // Toggle Minisearch modal search
        search: true,
        // Sitehero image style: 'square', 'rounded'
        siteheroStyle: "square",
        // Enable initial-letter styling on first paragraph
        initialLetter: false
    },

    // Feed content and links
    feeds: {
        // Include the RSS feed link in the HTML head
        rss: true,
        // Include the Atom feed link in the HTML head
        atom: true,
        // Include the JSON Feed link in the HTML head
        json: true,
        // Feed content: false = excerpts, true = full content
        fullContent: true,
        // Toggle for showing RSS feed link in the footer
        rssInFooter: true
    },

    // Label for the home menu link (mandatory)
    menuHome: "Home",
    // Additional menu items (key: label, value: URL)
    menuItems: {
        "Events": "/events/",
        "About us": "/about-us/"
    },

    // Header image for the landing page (relative path from the site root)
    header: "/images/header.jpeg",
    // Alt text for the header image (for accessibility)
    headerAlt: "",
    // Link for the header image (optional; no link by default)
    headerLink: "",

    // Social media profiles for the site
    social: {
        // GitHub username
        github: "lastguru-net",
        // LinkedIn username
        linkedin: "lastguru",
        // Twitter/X username
        twitter_x: "lastguru_net",
        // YouTube channel ID
        // youtube: "",
        // Facebook page name
        // fbPage: "",
        // Facebook username
        // fbProfile: "",
        // Mastodon profile URL
        mastodon: "https://toot.lv/@lastguru",
        // Bluesky profile URL
        bluesky: "https://bsky.app/profile/lastguru.net",
        // Instagram username
        // instagram: "",
        // Threads username
        threads: "lastguru_net"
    },

    // Privacy Policy link configuration (displayed in the footer or sidebar)
    // Set features.privacyPolicy to false to hide the link
    privacyPolicy: {
        name: "Privacy Policy",
        url: "/privacy-policy/"
    },

    // Powered-by configuration (displayed in footer when enabled)
    // - text: prefix shown before the link (e.g. "Powered by")
    // - name: link label (e.g. "Eleventy Minimal Pages")
    poweredBy: {
        text: "Powered by",
        name: "Eleventy Minimal Pages",
        url: "https://github.com/lastguru-net/emp"
    },

    // Copyright configuration (used in the footer)
    copyright: {
        // Copyright year (default is current year)
        year: "",
        // Copyright link (optional)
        link: "https://emp-starter.lastguru.dev",
        // Copyright text (optional)
        text: "test"
    }
}