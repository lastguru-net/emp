---
eleventyExcludeFromCollections: true
permalink: /feed.json
eleventyImport:
    collections: ["empPosts"]
---
{
    {% set items = collections.empPosts %}
    {# Publisher context #}
    {% set publisherData = siteauthors[siteconfig.author] %}
    {% set publisherName = publisherData.fullName or siteconfig.author %}
    {% set publisherWebsite = publisherData.website %}
    "version": "https://jsonfeed.org/version/1.1",
    "title": {{ siteconfig.title | jsonScript | safe }},
    "home_page_url": {{ '/' | absoluteUrl | jsonScript | safe }},
    "feed_url": {{ ("/feed.json" | absoluteUrl) | jsonScript | safe }},
    "description": {{ siteconfig.description | jsonScript | safe }},
    "language": {{ siteconfig.lang | jsonScript | safe }},
    "icon": {% set transformedImage %}{% imageTransformAbsoluteUrl siteconfig.image, 512, 'png' %}{% endset %}{{ transformedImage | jsonScript | safe }},
    "favicon": {% set transformedImage %}{% imageTransformAbsoluteUrl siteconfig.favicon, 64, 'png' %}{% endset %}{{ transformedImage | jsonScript | safe }},
    "authors": [
        {
            "name": {{ publisherName | jsonScript | safe }}{% if publisherWebsite %},
            "url": {{ publisherWebsite | jsonScript | safe }}{% endif %}
        }
    ],
    "items": [
        {% for item in items %}
            {# Per-item metadata #}
            {% set itemUrl = item.url | absoluteUrl %}
            {% set itemExcerpt = item.data.excerpt or (item | getExcerpt) %}
            {% set activeAuthorId = item.data.author or siteconfig.author %}
            {% set activeAuthorData = siteauthors[activeAuthorId] %}
            {% set activeAuthorDisplayName = activeAuthorData.fullName or activeAuthorId %}
            {% set authorPageUrl = (siteconfig.pagination.authorLinkPrefix ~ (activeAuthorId | empSlugify) ~ '/') | absoluteUrl %}
            {% set itemKeywords = item.data.tags | getKeywords %}
            {% set itemImageSrc = item.data.image or siteconfig.openGraphDefaultImage %}
            {
                "id": {{ itemUrl | jsonScript | safe }},
                "url": {{ itemUrl | jsonScript | safe }},
                "title": {{ (item.data.title or "") | jsonScript | safe }},
                {% if siteelements.feeds.fullContent %}
                "content_html": {{ item.templateContent | feedImageUrls | minifyFeedHtml | jsonScript | safe }},
                {% else %}
                "content_html": {{ itemExcerpt | jsonScript | safe }},
                {% endif %}
                "summary": {{ itemExcerpt | jsonScript | safe }},
                "image": {% set transformedImage %}{% imageTransformAbsoluteUrl itemImageSrc, 1200, 'webp' %}{% endset %}{{ transformedImage | jsonScript | safe }},
                "tags": {{ itemKeywords | jsonScript | safe }},
                "date_published": {{ (item.date | isoDateTime) | jsonScript | safe }},
                {% if item.data.updated %}"date_modified": {{ (item.data.updated | isoDateTime) | jsonScript | safe }},{% endif %}
                "authors": [
                    {
                        "name": {{ activeAuthorDisplayName | jsonScript | safe }},
                        "url": {{ authorPageUrl | jsonScript | safe }}
                    }
                ]
            }{% if not loop.last %},{% endif %}
        {% endfor %}
    ]
}