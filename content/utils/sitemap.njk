---
eleventyExcludeFromCollections: true
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}
    {% if item.data.hidden !== true %}
    {% set lastModified = item.data.updated or item.data.date %}
    <url>
        <loc>{{ item.url | absoluteUrl }}</loc>
        {% if lastModified %}
        <lastmod>{{ lastModified | isoDate }}</lastmod>
        {% endif %}
        <changefreq>{{ item.data.sitemapChangefreq | default("daily") }}</changefreq>
        <priority>{{ item.data.sitemapPriority | default(0.8) }}</priority>
    </url>
    {% endif %}
{% endfor %}
</urlset>