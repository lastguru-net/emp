---
eleventyExcludeFromCollections: true
permalink: /assets/js/min.js
---
{% if siteelements.features.topbar == "dynamic" %}{% include "../../assets/js/topbar.js" %}{% endif %}
{% if siteelements.features.base == "regular" %}{% include "../../assets/js/sidebar.js" %}{% endif %}
{% if siteelements.features.base == "regular" and (siteelements.features.search or siteelements.features.userMenu) %}{% include "../../assets/js/dialog-focus.js" %}{% endif %}
{% if siteelements.features.base == "regular" and siteelements.features.userMenu and siteelements.features.js and siteconfig.authentication.method %}{% authenticationMethod siteconfig.authentication, siteconfig.url %}{% include "../../assets/js/user-menu.js" %}{% endif %}
{% include "../../assets/js/clipboard.js" %}
{% if siteelements.features.search %}
const indexUrl = "{{ '/search-index.json' | url }}";
const miniSearchUrl = "{{ '/assets/js/minisearch.js' | url }}";
{% include "../../assets/js/search.js" %}
{% endif %}

{% if postlistJsTemplate or (siteelements.features.postproperties and siteelements.features.liveMetricsActions) %}
{% include "../../assets/js/html.js" %}
{% include "../../assets/js/post-properties.js" %}
const { renderProperties, renderMetricsActions } = createPostPropertiesRenderer(html);
{% endif %}

{% if siteelements.features.postproperties and siteelements.features.liveMetricsActions %}
{% include "../../assets/js/post-metrics-actions.js" %}
const metricsActionsContext = {{ {siteconfig: {lang: siteconfig.lang}, inlinesvg: inlinesvg} | jsonScript | safe }};
for (const region of document.querySelectorAll("[data-metrics-actions-url]")) mountMetricsActions(region, renderMetricsActions, metricsActionsContext);
{% endif %}

{% pluginsJs %}
{% if postlistJsTemplate %}{% include postlistJsTemplate %}{% endif %}