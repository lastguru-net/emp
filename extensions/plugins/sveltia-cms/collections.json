    {
        "name": "configuration",
        "label": "Configuration",
        "description": "Edit the site's configuration and theme source files. Changes take effect after the site is rebuilt.",
        "format": "raw",
        "files": [
            {
                "name": "siteconfig",
                "label": "Site configuration (siteconfig.js)",
                "file": "content/_data/siteconfig.js",
                "fields": [
                    {
                        "name": "body",
                        "label": "content/_data/siteconfig.js",
                        "widget": "code",
                        "default_language": "javascript",
                        "allow_language_selection": false,
                        "output_code_only": true
                    }
                ]
            },
            {
                "name": "siteelements",
                "label": "Site elements (siteelements.json5)",
                "file": "content/_data/siteelements.json5",
                "fields": [
                    {
                        "name": "body",
                        "label": "content/_data/siteelements.json5",
                        "widget": "code",
                        "default_language": "json5",
                        "allow_language_selection": false,
                        "output_code_only": true
                    }
                ]
            },
            {
                "name": "sitestrings",
                "label": "Site strings (sitestrings.json5)",
                "file": "content/_data/sitestrings.json5",
                "fields": [
                    {
                        "name": "body",
                        "label": "content/_data/sitestrings.json5",
                        "widget": "code",
                        "default_language": "json5",
